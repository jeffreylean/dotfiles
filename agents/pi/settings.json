{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "xhigh",
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-web-access@0.41.0",
    "npm:@ff-labs/pi-fff@0.11.0",
    "npm:pi-subagents@0.78.0",
    "npm:pi-intercom@0.13.0",
    "npm:@roodriigoooo/pi-hunk@0.9.0",
    "npm:@plannotator/pi-extension",
    "npm:pi-claude-bridge",
    "npm:pi-cloudflare"
  ],
  "subagents": {
    "agentOverrides": {
      "context-builder": {
        "thinking": "high"
      },
      "delegate": {
        "thinking": "medium"
      },
      "planner": {
        "thinking": "xhigh"
      },
      "researcher": {
        "thinking": "medium"
      },
      "reviewer": {
        "thinking": "high",
        "model": "openai-codex/gpt-6-sol"
      },
      "scout": {
        "thinking": "xhigh",
        "model": "openai-codex/gpt-6-luna"
      },
      "worker": {
        "thinking": "medium",
        "model": "openai-codex/gpt-6-sol"
      },
      "oracle": {
        "thinking": "xhigh",
        "model": "openai-codex/gpt-6-astra"
      },
      "evidence-auditor": {
        "thinking": "high",
        "model": "openai-codex/gpt-6-sol"
      }
    },
    "defaultModel": "openai-codex/gpt-5.6-terra"
  },
  "enableInstallTelemetry": false
}