{
  "lastChangelogVersion": "1.4.0",
  "theme": "dark",
  "defaultProvider": "claude-bridge",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "xhigh",
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-web-access@0.41.0",
    "npm:@ff-labs/pi-fff@0.11.0",
    "npm:pi-subagents@0.78.0",
    "npm:pi-intercom@0.13.0",
    "npm:@roodriigoooo/pi-hunk@0.9.0",
    "npm:@plannotator/pi-extension",
    "npm:pi-claude-bridge",
    "npm:pi-cloudflare",
    "git:github.com/michael-denyer/pstack-claude"
  ],
  "skills": [
    "!**/matt-skills/**",
    "+~/.agents/skills/matt-skills/grill-with-docs",
    "+~/.agents/skills/matt-skills/grilling",
    "+~/.agents/skills/matt-skills/domain-modeling"
  ],
  "subagents": {
    "agentOverrides": {
      "delegate": {
        "thinking": "medium"
      },
      "researcher": {
        "thinking": "medium"
      },
      "reviewer": {
        "thinking": "high",
        "model": "claude-bridge/claude-opus-5-5"
      },
      "scout": {
        "thinking": "xhigh",
        "model": "claude-bridge/claude-haiku-5-5"
      },
      "worker": {
        "thinking": "medium",
        "model": "claude-bridge/claude-sonnet-5-5"
      },
      "oracle": {
        "thinking": "xhigh",
        "model": "claude-bridge/claude-fable-5-1"
      },
      "evidence-auditor": {
        "thinking": "high",
        "model": "claude-bridge/claude-opus-5-5"
      },
      "fable-reviewer": {
        "thinking": "high",
        "model": "claude-bridge/claude-fable-5-1",
        "tools": ["read", "grep", "find", "ls", "bash", "edit", "write", "fetch_content"]
      }
    },
    "defaultModel": "claude-bridge/claude-sonnet-5-5"
  },
  "enableInstallTelemetry": false
}